# copy this file to .env and fill in real values — never commit .env itself

PORT=3000

# shown in the admin login form; keep this secret
ADMIN_PASSWORD=change-me

# random signing key for admin session cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Resend (https://resend.com) — used for approve/Sophos/blast emails.
# Leave RESEND_API_KEY empty to run without sending real email (logs to console instead).
RESEND_API_KEY=
RESEND_FROM="Don't Get Played <hello@apexaccs.org>"

# public site URL, used for links inside emails
SITE_URL=https://token.apexaccs.org

# optional: where the SQLite file lives (defaults to server/data/dgp.db)
# DB_PATH=/var/www/dgp/server/data/dgp.db
